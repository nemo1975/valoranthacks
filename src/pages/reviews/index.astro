---
import PageLayout from '../../layouts/PageLayout.astro';
import { customerReviewStats, customerReviews, fillBrandTokens, productInfo, siteConfig } from '../../data/site';
import { brandCopy, brandSeo, seoPageTitle } from '../../data/site-core';
import { seoDescription } from '../../data/brand';
import { getSelfHreflangAlternates } from '../../data/i18n/routing';
import { getReviewPath, reviewsBasePath } from '../../data/reviews';

const title = seoPageTitle(brandSeo.reviewsTitle);
const description = seoDescription(brandSeo.reviewsDescription);
const reviewsIntro = fillBrandTokens(brandCopy.reviewsIntro);

function stars(rating: number): string {
	return '★'.repeat(rating) + '☆'.repeat(5 - rating);
}

const dateFormatter = new Intl.DateTimeFormat('en', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
	timeZone: 'UTC',
});

function formatDate(isoDate: string): string {
	return dateFormatter.format(new Date(`${isoDate}T00:00:00Z`));
}

const sortedReviews = [...customerReviews].sort((a, b) => (a.date < b.date ? 1 : -1));

const canonicalURL = new URL(reviewsBasePath, siteConfig.url).href;
const hreflangAlternates = getSelfHreflangAlternates(reviewsBasePath);

const extraGraph: Record<string, unknown>[] = [
	{
		'@type': 'ItemList',
		'@id': `${canonicalURL}#list`,
		name: title,
		description,
		itemListElement: sortedReviews.map((review, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			url: new URL(getReviewPath(review.slug), siteConfig.url).href,
			name: review.seoTitle,
		})),
	},
];
---

<PageLayout
	title={title}
	description={description}
	canonicalPath={reviewsBasePath}
	heading={brandCopy.navReviews}
	intro={reviewsIntro}
	introEdit="reviewsIntro"
	eyebrow={brandCopy.navReviews}
	heroImage={siteConfig.heroImage}
	heroAlt={`${siteConfig.name} — Valorant ESP and aimbot`}
	hreflangAlternates={hreflangAlternates}
	extraGraph={extraGraph}
	ctaPrimary={{ href: siteConfig.checkoutUrl, label: brandCopy.ctaBuy, edit: 'ctaBuy' }}
	ctaSecondary={{ href: '/pricing/', label: 'View store' }}
>
	<section class="card-panel">
		<h2>Buyer rating</h2>
		<p>
			{siteConfig.name} holds a {customerReviewStats.averageRating.toFixed(1)} out of 5 score from{' '}
			{customerReviewStats.totalCount} verified buyers.
		</p>
		<div
			class="reviews-summary"
			aria-label={`${customerReviewStats.averageRating} out of 5 average rating`}
		>
			<p class="reviews-summary__avg">{customerReviewStats.averageRating.toFixed(1)}</p>
			<p class="reviews-summary__stars" aria-hidden="true">{stars(Math.round(customerReviewStats.averageRating))}</p>
			<p class="reviews-summary__count">{customerReviewStats.totalCount} reviews · out of 5</p>
		</div>
	</section>

	<section class="card-panel">
		<h2>What buyers say</h2>
		<p>Short notes on ESP, soft aim, radar, and support after a {productInfo.game} patch.</p>
		<div class="reviews-board">
			{
				sortedReviews.map((review) => (
					<article class="reviews-board__card">
						<div class="reviews-board__top">
							<div class="reviews-board__who">
								<span class="reviews-board__avatar" aria-hidden="true">
									{review.handle.charAt(0).toUpperCase()}
								</span>
								<div>
									<p class="reviews-board__handle">@{review.handle}</p>
									<p class="reviews-board__date">
										<time datetime={review.date}>{formatDate(review.date)}</time>
									</p>
								</div>
							</div>
							<p class="reviews-board__stars" aria-label={`${review.rating} out of 5 stars`}>
								{stars(review.rating)}
							</p>
						</div>
						<p class="reviews-board__text">{review.short}</p>
						<a class="reviews-board__more" href={getReviewPath(review.slug)}>
							Read full review →
						</a>
					</article>
				))
			}
		</div>
	</section>
</PageLayout>

<style>
	.reviews-summary {
		display: grid;
		gap: 0.15rem;
		justify-items: start;
		margin-top: 0.85rem;
		padding: 0.85rem 1.1rem;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid var(--line);
		background: var(--bg-elevated);
		width: fit-content;
		min-width: 10rem;
	}

	.reviews-summary__avg {
		font-family: var(--font-display);
		font-size: 1.85rem;
		font-weight: 800;
		line-height: 1;
		color: var(--magenta-soft);
	}

	.reviews-summary__stars {
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		color: var(--accent-amber);
	}

	.reviews-summary__count {
		font-size: 0.78rem;
		color: var(--ink-faint);
	}

	.reviews-board {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin-top: 0.85rem;
	}

	.reviews-board__card {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1rem 1.05rem;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid var(--line);
		background: var(--bg-elevated);
	}

	.reviews-board__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.reviews-board__who {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		min-width: 0;
	}

	.reviews-board__avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		width: 2.15rem;
		height: 2.15rem;
		border-radius: 999px;
		border: 1px solid var(--line-strong);
		background: var(--bg-panel);
		color: var(--magenta-soft);
		font-size: 0.9rem;
		font-weight: 800;
	}

	.reviews-board__handle {
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--ink);
		overflow-wrap: anywhere;
	}

	.reviews-board__date {
		margin-top: 0.1rem;
		font-size: 0.72rem;
		color: var(--ink-faint);
	}

	.reviews-board__stars {
		font-size: 0.82rem;
		letter-spacing: 0.04em;
		color: var(--accent-amber);
		white-space: nowrap;
	}

	.reviews-board__text {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		color: var(--ink-muted);
		font-size: 0.9rem;
		line-height: 1.55;
		min-height: calc(1.55em * 2);
		flex-grow: 1;
	}

	.reviews-board__more {
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--magenta);
	}

	.reviews-board__more:hover {
		color: var(--magenta-soft);
	}

	@media (max-width: 680px) {
		.reviews-board {
			grid-template-columns: 1fr;
		}

		.reviews-summary {
			width: 100%;
		}
	}
</style>
