---
import PageLayout from '../../../layouts/PageLayout.astro';
import { customerReviewStats, customerReviews, productInfo, siteConfig } from '../../../data/site';
import { brandCopy } from '../../../data/site-core';
import { getSelfHreflangAlternates } from '../../../data/i18n/routing';
import { getReviewPath, reviewsBasePath } from '../../../data/reviews';
import type { CustomerReview } from '../../../data/site';

export function getStaticPaths() {
	return customerReviews.map((review) => ({
		params: { slug: review.slug },
		props: { review },
	}));
}

const { review } = Astro.props as { review: CustomerReview };

const canonicalPath = getReviewPath(review.slug);
const canonicalURL = new URL(canonicalPath, siteConfig.url).href;
const hreflangAlternates = getSelfHreflangAlternates(canonicalPath);

function stars(rating: number): string {
	return '★'.repeat(rating) + '☆'.repeat(5 - rating);
}

const dateLabel = new Intl.DateTimeFormat('en', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
}).format(new Date(`${review.date}T00:00:00Z`));

const currentIndex = customerReviews.findIndex((r) => r.slug === review.slug);
const moreReviews = [1, 2, 3].map(
	(offset) => customerReviews[(currentIndex + offset) % customerReviews.length],
);

const extraGraph: Record<string, unknown>[] = [
	{
		'@type': 'Review',
		'@id': `${canonicalURL}#review`,
		url: canonicalURL,
		image: new URL(siteConfig.heroImage, siteConfig.url).href,
		author: { '@type': 'Person', name: review.handle },
		datePublished: review.date,
		reviewRating: {
			'@type': 'Rating',
			ratingValue: String(review.rating),
			bestRating: '5',
			worstRating: '1',
		},
		reviewBody: review.text,
		itemReviewed: {
			'@type': 'Product',
			'@id': `${siteConfig.url}/#product`,
			name: productInfo.name,
			description: productInfo.summary,
			image: new URL(siteConfig.heroImage, siteConfig.url).href,
			brand: { '@type': 'Brand', name: productInfo.brand },
			url: `${siteConfig.url}/`,
		},
		publisher: { '@id': `${siteConfig.url}/#organization` },
	},
];
---

<PageLayout
	title={review.seoTitle}
	description={review.seoDescription}
	canonicalPath={canonicalPath}
	heading={`@${review.handle}`}
	intro={review.short}
	eyebrow={brandCopy.navReviews}
	heroImage={siteConfig.heroImage}
	heroAlt={`${siteConfig.name} — Valorant ESP and aimbot`}
	hreflangAlternates={hreflangAlternates}
	type="article"
	crumbs={[
		{ label: 'Home', href: '/' },
		{ label: brandCopy.navReviews, href: reviewsBasePath },
		{ label: `@${review.handle}` },
	]}
	extraGraph={extraGraph}
	ctaPrimary={{ href: siteConfig.checkoutUrl, label: brandCopy.ctaBuy, edit: 'ctaBuy' }}
	ctaSecondary={{ href: '/pricing/', label: 'View store' }}
>
	<section class="card-panel">
		<h2>Review</h2>
		<p class="review-meta">
			<span aria-label={`${review.rating} out of 5 stars`}>{stars(review.rating)} {review.rating}/5</span>
			<span aria-hidden="true">·</span>
			<time datetime={review.date}>{dateLabel}</time>
			{review.tag ? <span class="review-chip">{review.tag}</span> : null}
			<span class="review-chip review-chip--ok">Verified buyer</span>
		</p>
		<blockquote class="review-quote">
			<p>{review.text}</p>
		</blockquote>
	</section>

	<section class="card-panel">
		<h2>More {productInfo.game} reviews</h2>
		<p>{customerReviewStats.totalCount} buyer notes on {siteConfig.name}.</p>
		<ul class="review-more">
			{
				moreReviews.map((other) => (
					<li>
						<a href={getReviewPath(other.slug)}>
							<span>@{other.handle}</span>
							<span aria-hidden="true">{stars(other.rating)}</span>
						</a>
					</li>
				))
			}
		</ul>
		<p><a href={reviewsBasePath}>All {brandCopy.navReviews.toLowerCase()}</a></p>
	</section>
</PageLayout>

<style>
	.review-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem 0.65rem;
		margin-top: 0.35rem;
		font-size: 0.85rem;
		color: var(--ink-faint);
	}

	.review-chip {
		display: inline-flex;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--magenta) 28%, var(--line));
		background: var(--bg);
		color: var(--magenta-soft);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.review-chip--ok {
		border-color: color-mix(in srgb, var(--ok) 35%, var(--line));
		color: var(--ok);
	}

	.review-quote {
		margin: 0.85rem 0 0;
		padding: 1rem 1.1rem;
		border-left: 2px solid color-mix(in srgb, var(--magenta) 55%, var(--line));
		border-radius: 0 0.65rem 0.65rem 0;
		background: var(--bg-elevated);
	}

	.review-more {
		margin-top: 0.75rem;
	}

	.review-more a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: var(--bg-elevated);
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
	}

	.review-more a:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		color: var(--magenta-soft);
	}
</style>
