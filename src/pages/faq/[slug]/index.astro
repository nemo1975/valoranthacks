---
import PageLayout from '../../../layouts/PageLayout.astro';
import { productInfo, seoFaqs, siteConfig, type FaqItem } from '../../../data/site';
import { brandCopy } from '../../../data/site-core';
import { absoluteFaqUrl, faqBasePath, getFaqPath, getRelatedFaqs } from '../../../data/faq';
import { getSelfHreflangAlternates } from '../../../data/i18n/routing';

export function getStaticPaths() {
	return seoFaqs.map((faq) => ({
		params: { slug: faq.slug },
		props: { faq },
	}));
}

const { faq } = Astro.props as { faq: FaqItem };

const canonicalPath = getFaqPath(faq.slug);
const canonicalURL = absoluteFaqUrl(faq.slug);
const hreflangAlternates = getSelfHreflangAlternates(canonicalPath);
const related = getRelatedFaqs(faq.slug, 4);
const heroUrl = new URL(siteConfig.heroImage, siteConfig.url).href;

const extraGraph: Record<string, unknown>[] = [
	{
		'@type': 'FAQPage',
		'@id': `${canonicalURL}#faq`,
		url: canonicalURL,
		image: heroUrl,
		primaryImageOfPage: {
			'@type': 'ImageObject',
			url: heroUrl,
		},
		mainEntity: [
			{
				'@type': 'Question',
				'@id': `${canonicalURL}#question`,
				name: faq.question,
				url: canonicalURL,
				acceptedAnswer: {
					'@type': 'Answer',
					text: faq.answer,
				},
			},
		],
	},
];
---

<PageLayout
	title={faq.seoTitle}
	description={faq.seoDescription}
	canonicalPath={canonicalPath}
	heading={faq.question}
	intro={faq.seoDescription}
	eyebrow="FAQ"
	heroImage={siteConfig.heroImage}
	heroAlt={`${siteConfig.name} — Valorant ESP and aimbot`}
	hreflangAlternates={hreflangAlternates}
	type="article"
	crumbs={[
		{ label: 'Home', href: '/' },
		{ label: 'FAQ', href: faqBasePath },
		{ label: 'Answer' },
	]}
	extraGraph={extraGraph}
	ctaPrimary={{ href: siteConfig.checkoutUrl, label: brandCopy.ctaBuy, edit: 'ctaBuy' }}
	ctaSecondary={{ href: '/pricing/', label: 'View store' }}
>
	<section class="card-panel">
		<h2>Answer</h2>
		<p>{faq.answer}</p>
	</section>

	<section class="card-panel">
		<h2>More questions</h2>
		<p>Other short answers about {productInfo.name} on Windows PC.</p>
		<ul class="faq-more">
			{
				related.map((item) => (
					<li>
						<a href={getFaqPath(item.slug)}>{item.question}</a>
					</li>
				))
			}
		</ul>
		<p><a href={faqBasePath}>All FAQ answers</a></p>
	</section>
</PageLayout>

<style>
	.faq-more a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: var(--bg-elevated);
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
	}

	.faq-more a:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		color: var(--magenta-soft);
	}
</style>
